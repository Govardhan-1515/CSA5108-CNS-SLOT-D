#include <stdio.h>
#include <string.h>

int main()
{
    char text[100], result[100];
    int key[100], i, n;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    n = strlen(text);

    printf("Enter %d key values (0-25):\n", n);

    for (i = 0; i < n; i++)
        scanf("%d", &key[i]);

    for (i = 0; i < n; i++)
        result[i] = ((text[i] - 'A' + key[i]) % 26) + 'A';

    result[n] = '\0';

    printf("Encrypted text: %s\n", result);

    return 0;
}
