#include <stdio.h>
#include <string.h>

int main()
{
    char text[500];
    char frequency[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";
    int count[26] = {0};
    int used[26] = {0};
    int i, j, max, index;
    char map[26];

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] >= 'A' && text[i] <= 'Z')
            count[text[i] - 'A']++;
        else if (text[i] >= 'a' && text[i] <= 'z')
            count[text[i] - 'a']++;
    }

    for (i = 0; i < 26; i++) {
        max = -1;
        index = -1;

        for (j = 0; j < 26; j++) {
            if (!used[j] && count[j] > max) {
                max = count[j];
                index = j;
            }
        }

        if (index >= 0) {
            map[index] = frequency[i];
            used[index] = 1;
        }
    }

    printf("\nEstimated plaintext:\n");

    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] >= 'A' && text[i] <= 'Z')
            printf("%c", map[text[i] - 'A']);
        else if (text[i] >= 'a' && text[i] <= 'z')
            printf("%c", map[text[i] - 'a'] + 32);
        else
            printf("%c", text[i]);
    }

    return 0;
}
