#include <stdio.h>
#include <stdint.h>

uint64_t simple_round(uint64_t block, uint64_t key) {
    return block ^ key;
}

int main() {
    uint64_t cipher, keys[16];

    printf("Enter ciphertext (hex): ");
    scanf("%llx", &cipher);

    printf("Enter 16 subkeys (hex):\n");
    for (int i = 0; i < 16; i++) {
        printf("K%d: ", i + 1);
        scanf("%llx", &keys[i]);
    }

    printf("\nDecryption using reverse key order:\n");

    uint64_t data = cipher;

    for (int i = 15; i >= 0; i--) {
        data = simple_round(data, keys[i]);
        printf("Using K%d -> %016llX\n", i + 1, data);
    }

    printf("\nDecrypted block = %016llX\n", data);

    return 0;
}
