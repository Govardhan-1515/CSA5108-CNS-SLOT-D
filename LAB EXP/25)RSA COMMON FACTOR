#include <stdio.h>

int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    int n, e, m;

    printf("Enter n: ");
    scanf("%d", &n);

    printf("Enter public exponent e: ");
    scanf("%d", &e);

    printf("Enter plaintext block m: ");
    scanf("%d", &m);

    int g = gcd(m, n);

    printf("\ngcd(%d, %d) = %d\n", m, n, g);

    if (g > 1 && g < n) {
        printf("A non-trivial factor of n has been found.\n");
        printf("Factor = %d\n", g);
        printf("Therefore RSA security is compromised.\n");
    } else {
        printf("No useful factor of n was found.\n");
    }

    return 0;
}
