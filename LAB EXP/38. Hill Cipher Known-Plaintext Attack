#include <stdio.h>

int main()
{
    int key[2][2], plain[2][2];
    int cipher[2][2], i, j, k;

    printf("Enter 2x2 key matrix:\n");

    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
            scanf("%d", &key[i][j]);

    printf("Enter known plaintext matrix:\n");

    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
            scanf("%d", &plain[i][j]);

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            cipher[i][j] = 0;

            for (k = 0; k < 2; k++)
                cipher[i][j] += key[i][k] * plain[k][j];

            cipher[i][j] %= 26;
        }
    }

    printf("\nEncrypted matrix:\n");

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++)
            printf("%d ", cipher[i][j]);

        printf("\n");
    }

    return 0;
}
