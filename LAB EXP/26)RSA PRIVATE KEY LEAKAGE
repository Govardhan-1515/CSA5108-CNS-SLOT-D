#include <stdio.h>

int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int modInverse(int e, int phi) {
    for (int d = 1; d < phi; d++) {
        if ((e * d) % phi == 1)
            return d;
    }
    return -1;
}

int main() {
    int p, q, e, newE;

    printf("Enter original p: ");
    scanf("%d", &p);

    printf("Enter original q: ");
    scanf("%d", &q);

    printf("Enter old public key e: ");
    scanf("%d", &e);

    int n = p * q;
    int phi = (p - 1) * (q - 1);

    int d = modInverse(e, phi);

    printf("\nOriginal RSA:\n");
    printf("n = %d\n", n);
    printf("e = %d\n", e);
    printf("d = %d\n", d);

    printf("\nEnter new public exponent e: ");
    scanf("%d", &newE);

    if (gcd(newE, phi) != 1) {
        printf("Invalid new e.\n");
        return 0;
    }

    int newD = modInverse(newE, phi);

    printf("\nNew RSA keys using SAME modulus:\n");
    printf("n  = %d\n", n);
    printf("e' = %d\n", newE);
    printf("d' = %d\n", newD);

    printf("\nIs this safe? NO.\n");
    printf("A new modulus should be generated.\n");

    return 0;
}
