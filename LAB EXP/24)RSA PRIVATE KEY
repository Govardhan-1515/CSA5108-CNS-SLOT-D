#include <stdio.h>

int main() {
    int e = 31;
    int n = 3599;

    int p = 0, q = 0;

    for (int i = 2; i < n; i++) {
        if (n % i == 0) {
            p = i;
            q = n / i;
            break;
        }
    }

    int phi = (p - 1) * (q - 1);

    int d;

    for (d = 1; d < phi; d++) {
        if ((e * d) % phi == 1)
            break;
    }

    printf("n = %d\n", n);
    printf("p = %d\n", p);
    printf("q = %d\n", q);
    printf("phi(n) = %d\n", phi);
    printf("Public key  = (%d, %d)\n", e, n);
    printf("Private key = (%d, %d)\n", d, n);

    return 0;
}
