#include <stdio.h>
#include <string.h>

int main()
{
    char text[500];
    int freq[26] = {0};
    int i, j, max, index;
    char letters[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++) {
        if (text[i] >= 'A' && text[i] <= 'Z')
            freq[text[i] - 'A']++;
        else if (text[i] >= 'a' && text[i] <= 'z')
            freq[text[i] - 'a']++;
    }

    printf("\nFrequency analysis:\n");

    for (i = 0; i < 26; i++) {
        max = -1;
        index = -1;

        for (j = 0; j < 26; j++) {
            if (freq[j] > max) {
                max = freq[j];
                index = j;
            }
        }

        if (max > 0) {
            printf("%c -> %c : %d\n",
                   index + 'A', letters[i], max);
            freq[index] = -1;
        }
    }

    return 0;
}
